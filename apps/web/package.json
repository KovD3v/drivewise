{
  "name": "@drivewise/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:api-types": "mkdir -p node_modules/.cache && uv run --frozen --project ../api python ../api/scripts/export_openapi.py > node_modules/.cache/openapi.json && openapi-typescript node_modules/.cache/openapi.json --default-non-nullable false -o src/api/schema.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "nitro": "^3.0.260903-beta",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
