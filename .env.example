# Shared
APP_ENV=local

# Frontend
# Use /api when the site and the API share one origin (see README).
VITE_API_BASE_URL=http://127.0.0.1:8000
# Server rendering's absolute API URL when VITE_API_BASE_URL is relative.
API_INTERNAL_URL=
# Local one-origin runs: forward /api to this API (build or dev time).
API_PROXY_TARGET=
# true only for a build that serves the synthetic demo catalogue.
VITE_SYNTHETIC_DATA=false

# Backend
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to /api when the API shares a domain with the frontend. Empty locally.
API_ROOT_PATH=

# Neon PostgreSQL
DATABASE_URL=postgresql://your-user:your-password@your-neon-host.neon.tech/your-database?sslmode=require
TEST_DATABASE_URL=postgresql://your-user:your-password@your-test-host.neon.tech/your-test-database?sslmode=require
PGVECTOR_ENABLED=false

# Catalog collection: only scripts/scrape_catalog.py --run makes provider requests.
# Choose an OpenRouter model that supports tool calling. No implicit model default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Default acquisition: Tinyfish Search/Fetch. Paid Agent needs --tinyfish-agent.
TINYFISH_API_KEY=
# Optional alternative acquisition; required only with --provider firecrawl.
FIRECRAWL_API_KEY=

# Initial cache uses PostgreSQL. Keep Redis optional for a future task.
CACHE_BACKEND=postgres
REDIS_URL=
