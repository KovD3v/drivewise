# Shared
APP_ENV=local

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_USE_MOCK_API=false

# Backend
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Neon PostgreSQL
DATABASE_URL=postgresql://your-user:your-password@your-neon-host.neon.tech/your-database?sslmode=require
TEST_DATABASE_URL=postgresql://your-user:your-password@your-test-host.neon.tech/your-test-database?sslmode=require
PGVECTOR_ENABLED=false

# Firecrawl planning is available, but real crawling is disabled by default.
FIRECRAWL_API_KEY=

# Initial cache uses PostgreSQL. Keep Redis optional for a future task.
CACHE_BACKEND=postgres
REDIS_URL=
